# Nunca compartilhe este arquivo preenchido nem faça commit da chave real.
YOUTUBE_API_KEY=

# Use o ID do canal, não o nome exibido nem necessariamente o @handle.
YOUTUBE_CHANNEL_ID=cole_um_channel_id_aqui

# Para a extração em lote, use IDs separados por vírgula.
YOUTUBE_CHANNEL_IDS=id_1,id_2,id_3

# Primeira extração pequena; máximo permitido pelo endpoint: 50.
YOUTUBE_MAX_VIDEOS=5

# Chave separada, criada no Google AI Studio, para o piloto multimodal.
GEMINI_API_KEY=

# Modelo usado pelo piloto; pode ser trocado sem alterar o script.
GEMINI_MODEL=gemini-3.8-flash
